# Port the API + Socket.IO server listens on
PORT=5000
# MongoDB Atlas connection string, including the DB name (...mongodb.net/overlayproctor?...)
MONGO_URI=
# Long random string used to sign JWT access tokens (never commit the real one)
JWT_SECRET=
# Access token lifetime
JWT_EXPIRES_IN=8h
# Allowed frontend origin(s), comma-separated (local + Vercel URL)
CLIENT_URL=http://localhost:5173
# Upstash Redis TCP URL (rediss://default:<pass>@<host>.upstash.io:6379). Empty = single instance, in-memory counters
REDIS_URL=
# development | production
NODE_ENV=development
