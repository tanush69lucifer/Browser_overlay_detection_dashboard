# Port the API + Socket.IO server listens on
PORT=5000
# MongoDB Atlas connection string, including the database name
MONGO_URI=
# Long random string used to sign JWT access tokens (never commit the real one)
JWT_SECRET=
# Access token lifetime
JWT_EXPIRES_IN=8h
# Google OAuth Web client ID (must match VITE_GOOGLE_CLIENT_ID in client/.env)
GOOGLE_CLIENT_ID=
# Allowed frontend origin(s), comma-separated
CLIENT_URL=http://localhost:5173
# Optional Redis URL. Empty uses in-memory counters for a single instance.
REDIS_URL=
# development | production
NODE_ENV=development
